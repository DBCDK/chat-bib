{
  "name": "chatbib-ui",
  "version": "0.1.0",
  "private": false,
  "license": "mit",
  "scripts": {
    "build:styles": "mkdir -p public/styles && sh -c 'for src in app/styles/globals-*.scss; do [ -e \"$src\" ] || continue; base=$(basename \"$src\" .scss); sass --no-source-map \"$src:public/styles/$base.css\"; done'",
    "predev": "npm run build:styles",
    "dev": "next dev",
    "prebuild": "npm run build:styles",
    "build": "cross-env BUILD_MODE=standalone next build",
    "start": "next start",
    "lint": "next lint",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "prepare": "husky install",
    "prettier": "prettier --write 'app/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@apollo/client": "^3.10.8",
    "@dbcdk/login-nextjs": "^4.0.6",
    "@fortaine/fetch-event-source": "^3.0.6",
    "@hello-pangea/dnd": "^16.5.0",
    "@svgr/webpack": "^6.5.1",
    "dbc-node-logger": "^2.0.11",
    "emoji-picker-react": "^4.9.2",
    "fuse.js": "^7.0.0",
    "graphql": "^16.9.0",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.11",
    "mermaid": "^10.6.1",
    "nanoid": "^5.0.3",
    "next": "^14.2.29",
    "next-auth": "^4.24.10",
    "nodemailer": "^6.9.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^6.15.0",
    "rehype-highlight": "^6.0.0",
    "rehype-katex": "^6.0.3",
    "remark-breaks": "^3.0.2",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sass": "^1.59.2",
    "spark-md5": "^3.0.2",
    "swr": "^2.2.5",
    "undici": "^5.20.0",
    "use-debounce": "^9.0.4",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.7",
    "@types/react-katex": "^3.0.0",
    "@types/spark-md5": "^3.0.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.49.0",
    "eslint-config-next": "13.4.19",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.0",
    "lint-staged": "^13.2.2",
    "prettier": "^3.3.2",
    "typescript": "5.2.2",
    "webpack": "^5.88.1"
  },
  "resolutions": {
    "lint-staged/yaml": "^2.2.2"
  }
}
